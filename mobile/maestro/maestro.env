# The Maestro release both workflows install (#278): mobile-ci.yml, where the flows are developed,
# and live-tests.yml, which runs the live ones against qa -- one pin, so a flow that passes in Mobile
# CI is never run on an older Maestro after a deploy. Its own file rather than emulator.env, whose
# hash is the emulator cache's tag. get.maestro.mobile.dev reads MAESTRO_VERSION.
MAESTRO_VERSION=2.11.0
