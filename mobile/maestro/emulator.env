# The emulator Mobile CI runs the Maestro flows on, in one place for mobile-ci.yml, which runs them,
# and emulator-cache.yml, which caches its setup (#302). A change here is a new cache tag
# (emulator-cache.sh). Read with `source`, and into GITHUB_ENV through it.
EMULATOR_API_LEVEL=34
EMULATOR_TARGET=google_apis
EMULATOR_ARCH=x86_64
EMULATOR_OPTIONS="-no-window -gpu swiftshader_indirect -noaudio -no-boot-anim -camera-back none"
# The emulator's own 2560 MB ran out as Chrome opened Keycloak's page: Android could not start its
# renderer and killed Chrome mid sign-in (#420).
EMULATOR_RAM_SIZE=4096M
