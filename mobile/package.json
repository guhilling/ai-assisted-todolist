{
  "name": "taskfest-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.5",
    "oxlint": "^1.87.0",
    "react-dom": "^19.2.3",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check:deps": "node ../frontend/scripts/check-no-prerelease-deps.mjs ."
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/Main.tsx",
      "!src/**/*.d.ts"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testTimeout": 15000,
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 90,
        "functions": 93,
        "lines": 95
      }
    }
  }
}
