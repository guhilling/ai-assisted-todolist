{
  "name": "taskfest-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-auth-session": "~58.0.19",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-google-signin": "^2.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "oxlint": "^1.87.0",
    "patch-package": "8.0.1",
    "react-dom": "19.3.0",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check:deps": "node ../frontend/scripts/check-no-prerelease-deps.mjs .",
    "postinstall": "patch-package"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/Main.tsx",
      "!src/testing.ts",
      "!src/**/*.d.ts"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testTimeout": 15000,
    "coverageThreshold": {
      "global": {
        "statements": 96,
        "branches": 92,
        "functions": 94,
        "lines": 97
      }
    }
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-sharing"
        ]
      }
    }
  }
}
