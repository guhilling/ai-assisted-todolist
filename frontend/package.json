{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ds": "vite build --config vite.ds.config.ts && tsc -p tsconfig.ds.json",
    "generate:api": "node scripts/generate-api.mjs",
    "lint": "oxlint",
    "check:deps": "node scripts/check-no-prerelease-deps.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "module": "./dist-ds/index.js",
  "types": "./dist-ds/design-system.d.ts",
  "exports": {
    ".": {
      "types": "./dist-ds/design-system.d.ts",
      "import": "./dist-ds/index.js"
    },
    "./styles.css": "./dist-ds/frontend.css"
  }
}
