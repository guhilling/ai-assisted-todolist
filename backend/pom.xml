<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.guhilling.todo</groupId>
    <artifactId>backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <properties>
        <compiler-plugin.version>3.14.0</compiler-plugin.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.25.2</quarkus.platform.version>
        <skipITs>true</skipITs>
        <surefire-plugin.version>3.5.3</surefire-plugin.version>
        <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
        <jacoco-plugin.version>0.8.13</jacoco-plugin.version>
        <pitest-plugin.version>1.30.0</pitest-plugin.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
        <!-- quarkus-jacoco's default. Named here because the jacoco plugin's agent
             and check goal both have to point at the same file. -->
        <jacoco.data-file>${project.build.directory}/jacoco-quarkus.exec</jacoco.data-file>
        <!-- The gate. Set just below what the suite actually achieves, so it ratchets
             rather than blocking; raise it when coverage rises, never lower it to fit. -->
        <jacoco.line-minimum>0.95</jacoco.line-minimum>
        <jacoco.branch-minimum>0.90</jacoco.branch-minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-container-image-jib</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-logging-json</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The stock JaCoCo agent cannot instrument the classes Quarkus rewrites at
                 build time, which are loaded by QuarkusClassLoader. Without this extension
                 the Panache entities and everything touching them report 0% coverage even
                 though the tests exercise them on every run. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jacoco</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security-oidc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- jboss-threads resets thread locals on Java 24+, which needs java.lang
                         opened to the unnamed module. Without it, dev mode throws
                         IllegalAccessError on every request-handling thread. Surefire and
                         failsafe below pass the same flag for the JVMs they fork.
                         The plugin's own openJavaLang option would be the obvious way to ask
                         for this, but in 3.25.2 it emits a doubled '=' and the forked JVM
                         refuses to boot, so the flag is spelled out here instead. -->
                    <jvmArgs>--add-opens java.base/java.lang=ALL-UNNAMED</jvmArgs>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                            <goal>native-image-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <!-- jboss-threads needs this to reset thread locals on Java 24+;
                         @{argLine} keeps the JaCoCo agent that prepare-agent put there. -->
                    <argLine>@{argLine} --add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <argLine>--add-opens java.base/java.lang=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle-plugin.version}</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <failsOnError>true</failsOnError>
                    <violationSeverity>warning</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <!-- PIT discovers tests through the build tool's test engine, so JUnit 5
                             support is a separate plugin rather than built in. -->
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest-junit5-plugin.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <!-- Deliberately wide, so a new production class with no fast unit test shows
                         up in the report as uncovered mutants rather than being invisible. Since
                         there is no threshold, this informs rather than enforces: it only works if
                         somebody reads the report. -->
                    <targetClasses>
                        <param>io.github.guhilling.todo.*</param>
                    </targetClasses>
                    <!-- An allowlist, not a pattern: only tests that do not boot Quarkus.
                         PIT gives every mutant a fresh minion JVM, so a @QuarkusTest in scope
                         means a full application boot with its own Dev Services PostgreSQL and
                         Keycloak containers. Measured on this codebase: mutating one class
                         covered by a @QuarkusTest took 163 seconds for 14 mutants with most
                         minions timing out; letting a single lightweight @QuarkusTest into
                         scope took coverage calculation from under a second to 24; and putting
                         the whole suite in scope aborts before mutating anything at all,
                         because KeycloakLoginFlowTest cannot start its containers inside the
                         minion.
                         An allowlist because the failure mode then is benign. A new plain unit
                         test simply is not mutated until it is named here, whereas a pattern
                         that swept in a new @QuarkusTest would silently make every run minutes
                         slower, or break it outright. -->
                    <targetTests>
                        <param>io.github.guhilling.todo.api.AuthProviderMappingTest</param>
                    </targetTests>
                    <!-- The classes no allowlisted test reaches, excluded so the score reflects
                         what was actually measured rather than being diluted by code PIT could
                         never reach. Every line is a class with no fast unit test behind it, and
                         deleting a line is the reward for writing one: dropping the AuthResource
                         line, for instance, adds eight NO_COVERAGE mutants and takes the reported
                         score from 100% to 56%. -->
                    <excludedClasses>
                        <param>io.github.guhilling.todo.api.AuthResource*</param>
                        <param>io.github.guhilling.todo.api.TaskResource*</param>
                        <param>io.github.guhilling.todo.model.*</param>
                        <param>io.github.guhilling.todo.service.*</param>
                        <!-- SmallRye generates the config mapping implementation; it is not ours
                             to test and its mutants are unkillable by construction. -->
                        <param>*$$CMImpl</param>
                    </excludedClasses>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <!-- PIT reads surefire's configuration by default, and surefire's argLine
                         carries JaCoCo's @{argLine} placeholder, which is only substituted when
                         prepare-agent runs in the same session. PIT resolves it literally and
                         dies on a file called "{argLine}". The minion JVM arguments are therefore
                         spelled out below: the same add-opens flag surefire passes, plus the log
                         manager the Quarkus tests need. -->
                    <parseSurefireConfig>false</parseSurefireConfig>
                    <jvmArgs>
                        <jvmArg>--add-opens</jvmArg>
                        <jvmArg>java.base/java.lang=ALL-UNNAMED</jvmArg>
                        <jvmArg>-Djava.util.logging.manager=org.jboss.logmanager.LogManager</jvmArg>
                    </jvmArgs>
                    <!-- No mutationThreshold on purpose. With one production class in scope a
                         gate would police a corner of the codebase while saying nothing about the
                         rest, so PIT reports and does not block. Revisit if the scope widens. -->
                </configuration>
                <executions>
                    <execution>
                        <!-- At verify, beside Checkstyle and the coverage gate, so one command
                             runs every quality check and backend-ci needs no extra step. -->
                        <id>pitest-mutation-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-plugin.version}</version>
                <configuration>
                    <!-- quarkus-jacoco owns the report. This plugin only supplies the agent
                         for tests that do not boot Quarkus, and the check goal that gates
                         the build; both work on the extension's data file. -->
                    <dataFile>${jacoco.data-file}</dataFile>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- Classes the Quarkus classloader owns are counted by the
                                 extension instead; letting the agent try as well records
                                 them twice under two different class ids. -->
                            <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
                            <destFile>${jacoco.data-file}</destFile>
                            <append>true</append>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line-minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch-minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
