<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tasks are open or done (#334): the website and the app stop offering "in progress", and the tasks
  that were in progress become open. WORKING itself stays in the task_state type and the API until
  #345, because apps installed before this release can still send it, and the API stores it as open.
  No rollback: which tasks were in progress is not kept anywhere.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-in-progress-becomes-open" author="guhilling">
        <sql>UPDATE task SET state = 'TODO', updated_at = now() WHERE state = 'WORKING'</sql>
        <rollback/>
    </changeSet>

</databaseChangeLog>
