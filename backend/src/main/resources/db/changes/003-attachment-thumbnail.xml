<?xml version="1.0" encoding="UTF-8"?>
<!--
  Preview thumbnails (#236): whether an attachment has one, stored next to its file in S3 under the
  file's key plus ".thumbnail". Every attachment before this one has none, and the row shows the
  file itself as before.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-add-attachment-thumbnail" author="guhilling">
        <addColumn tableName="attachment">
            <column name="thumbnail" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
