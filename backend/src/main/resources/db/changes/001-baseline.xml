<?xml version="1.0" encoding="UTF-8"?>
<!--
  The whole schema, as one baseline.

  This replaces the three changelogs that built it up: todoitem, then app_user, then the
  replacement of todoitem by task. None of that history is worth carrying, because no database
  it applied to outlived it. Every environment here is created from scratch, so the only thing
  the old sequence added was the need to read three files to learn the shape of two tables.

  The schema is PostgreSQL-specific and deliberately so. `state` and `importance` are native
  enum types rather than VARCHAR, so the database rejects a value the application does not
  define, instead of storing it and leaving the mistake to be found later.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Liquibase has no change type for an enum, so these are raw SQL. Adding a value later is a
      new changeSet with `ALTER TYPE ... ADD VALUE`, which PostgreSQL allows; removing or
      renaming one is not, and needs a new type and a column rewrite. That asymmetry is the
      price of having the database enforce the values, and it is why the rollback drops the
      type rather than trying to edit it.
    -->
    <changeSet id="001-create-task-state-type" author="guhilling">
        <sql>CREATE TYPE task_state AS ENUM ('TODO', 'WORKING', 'DONE')</sql>
        <rollback>DROP TYPE task_state</rollback>
    </changeSet>

    <changeSet id="001-create-task-importance-type" author="guhilling">
        <sql>CREATE TYPE task_importance AS ENUM ('LOW', 'MEDIUM', 'HIGH')</sql>
        <rollback>DROP TYPE task_importance</rollback>
    </changeSet>

    <changeSet id="001-create-app-user-table" author="guhilling">
        <createTable tableName="app_user">
            <column name="id" type="BIGINT" autoIncrement="true" generationType="BY DEFAULT" startWith="1">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_app_user_email"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="001-create-task-table" author="guhilling">
        <createTable tableName="task">
            <column name="id" type="BIGINT" autoIncrement="true" generationType="BY DEFAULT" startWith="1">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="due_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="importance" type="task_importance">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="task_state">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="BIGINT">
                <constraints nullable="false" references="app_user(id)" foreignKeyName="fk_task_owner"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
