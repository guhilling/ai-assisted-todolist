# Copy to .env and fill in real values for a production-shaped run. Never commit .env.
#
# Local development needs none of this: `./mvnw quarkus:dev` starts PostgreSQL and a Keycloak
# with the accounts gunnar and lasse, and signs you in against that instead of Google.

# --- Database -----------------------------------------------------------------------------
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/todolist
QUARKUS_DATASOURCE_USERNAME=todolist
QUARKUS_DATASOURCE_PASSWORD=todolist

# --- Google sign-in (the only production provider) ----------------------------------------
# Create the credentials in the Google Cloud console as an OAuth 2.0 Web application client,
# with the redirect URI <your origin>/api/auth/callback.
QUARKUS_OIDC_ENABLED=true
TODO_AUTH_ENABLED=true
TODO_OIDC_GOOGLE_CLIENT_ID=
TODO_OIDC_GOOGLE_CLIENT_SECRET=

# --- Application --------------------------------------------------------------------------
FRONTEND_ORIGINS=http://localhost:3000
TODO_AUTH_POST_LOGIN_REDIRECT_URI=http://localhost:3000/
# Leave the session cookie Secure unless you are serving the app over plain HTTP.
TODO_OIDC_COOKIE_SECURE=true
