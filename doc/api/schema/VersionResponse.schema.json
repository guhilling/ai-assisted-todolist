{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VersionResponse.schema.json",
  "type": "object",
  "required": [
    "version",
    "minimumAppVersion"
  ],
  "properties": {
    "version": {
      "type": "string",
      "examples": [
        "0.11.0"
      ],
      "maxLength": 64
    },
    "minimumAppVersion": {
      "type": "string",
      "examples": [
        "1.0.0"
      ],
      "maxLength": 64
    }
  }
}
