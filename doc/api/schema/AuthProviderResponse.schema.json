{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AuthProviderResponse.schema.json",
  "required": [
    "id",
    "label",
    "available",
    "loginUrl",
    "issuer"
  ],
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "examples": [
        "google"
      ],
      "maxLength": 64
    },
    "label": {
      "type": "string",
      "examples": [
        "Google"
      ],
      "maxLength": 100
    },
    "available": {
      "type": "boolean"
    },
    "loginUrl": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "/api/auth/login"
      ],
      "maxLength": 2048
    },
    "issuer": {
      "type": "string",
      "examples": [
        "https://accounts.google.com"
      ],
      "maxLength": 2048
    }
  }
}
