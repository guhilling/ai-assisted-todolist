{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LinkRequest.schema.json",
  "type": "object",
  "required": [
    "url"
  ],
  "properties": {
    "url": {
      "type": "string",
      "examples": [
        "https://example.com/articles/42"
      ],
      "pattern": "^(?i)https?://[^\\s/?#:]+(:[0-9]{1,5})?([/?#][^\\s]*)?$",
      "maxLength": 2048
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "An article worth reading"
      ],
      "maxLength": 1024
    }
  }
}
