{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TaskCreateRequest.schema.json",
  "type": "object",
  "required": [
    "description",
    "dueDate",
    "importance",
    "state"
  ],
  "properties": {
    "description": {
      "type": "string",
      "examples": [
        "Renew the passport"
      ],
      "pattern": "\\S",
      "maxLength": 255
    },
    "dueDate": {
      "type": "string",
      "examples": [
        "2026-11-30"
      ],
      "$ref": "LocalDate.schema.json"
    },
    "dueTime": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "The time of day it is due at, to the minute (#474); none, or null, for a task due all day. Floating without a timeZone.",
      "examples": [
        "10:00"
      ]
    },
    "timeZone": {
      "type": [
        "string",
        "null"
      ],
      "description": "The IANA zone dueTime is meant in (#474), one the backend knows; only with a dueTime. None, or null, for a floating time, which follows the reader's clock.",
      "examples": [
        "Europe/Berlin"
      ],
      "maxLength": 64
    },
    "importance": {
      "type": "string",
      "examples": [
        "HIGH"
      ],
      "$ref": "TaskImportance.schema.json"
    },
    "state": {
      "type": "string",
      "examples": [
        "TODO"
      ],
      "$ref": "TaskState.schema.json"
    },
    "attachmentIds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer",
        "format": "int64"
      },
      "description": "Attachments of a task deleted moments ago, for an undo to bring back (#204); only the caller's, only within the undo window.",
      "maxItems": 10
    }
  }
}
