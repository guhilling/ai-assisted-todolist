{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CurrentUserResponse.schema.json",
  "type": "object",
  "required": [
    "email"
  ],
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "examples": [
        "person@example.com"
      ],
      "maxLength": 254
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "Person Example"
      ],
      "maxLength": 255
    },
    "pictureUrl": {
      "type": [
        "string",
        "null"
      ],
      "examples": [
        "https://example.com/avatar.jpg"
      ],
      "maxLength": 2048
    }
  }
}
