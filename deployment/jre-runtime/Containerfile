# jre-runtime: Temurin's full JRE on Red Hat UBI 10 micro (#66).
#
# A base image for JVM applications, published as quay.io/ghilling/jre-runtime and meant to be
# reused beyond this project. The backend's Jib build runs on it.
#
# Why not Temurin's own UBI image: that is UBI *minimal* plus ~130 packages a JVM never touches
# (binutils, systemd, dbus, curl, wget, gnupg, microdnf, fonts), 152 OS packages in all, and
# those are where nearly every scanner finding came from. UBI micro has 24. The JRE needs only
# glibc from the OS -- java, libjvm, libjava, libnet and libjli link nothing else -- and brings
# its own CA certificates and zlib; the X11, ALSA and freetype libraries it lists are AWT's, which
# a headless service never loads. doc/decisions/containers-and-local-stack.md has the measurements.
#
# Both stages are pinned to a tag and the digest of its multi-arch index, so a rebuild is the
# same image; Renovate's Dockerfile manager moves them. UBI micro has no package manager, no
# grep and no curl -- anything that runs inside the container has to make do with bash and
# coreutils.

FROM docker.io/library/eclipse-temurin:25.0.4.1_1-jre-ubi10-minimal@sha256:389987e3b9e555725a895350323f4a781074fe68e52093d403e1065814835a17 AS jre

FROM registry.access.redhat.com/ubi10/ubi-micro:10.2-1792455530@sha256:1c105e547de5d9e0bc20d06ebabee73b20bc6bba994c50ae3e207684fd8bef2b

LABEL org.opencontainers.image.title="jre-runtime" \
      org.opencontainers.image.description="Eclipse Temurin JRE on Red Hat UBI 10 micro" \
      org.opencontainers.image.source="https://github.com/guhilling/ai-assisted-todolist/tree/main/deployment/jre-runtime"

ENV JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:/usr/bin:/bin \
    LANG=C.UTF-8

COPY --from=jre /opt/java/openjdk /opt/java/openjdk
